<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_BusinessPartners_183016" targetNamespace="https://github.com/jesusrevilla/ERP-simulator/business-partners/183016">
  <bpmn:process id="BP_BankChange_183016" name="Control seguro de cambio de cuenta bancaria de proveedor" isExecutable="false">
    <bpmn:documentation>Modelo BPMN 2.0 de planeacion funcional. Datos simulados. El cambio no se implementa en SAP Business One en esta entrega.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_BP_183016">
      <bpmn:lane id="Lane_1" name="Proveedor">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Compras">
        <bpmn:flowNodeRef>Register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Maestros">
        <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Finanzas">
        <bpmn:flowNodeRef>Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Verified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Accepted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_5" name="Tesoreria">
        <bpmn:flowNodeRef>Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndOK</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Cambio solicitado">
      <bpmn:outgoing>f01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Register" name="Registrar solicitud">
      <bpmn:incoming>f01</bpmn:incoming>
      <bpmn:outgoing>f02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Validate" name="Validar BP y documento">
      <bpmn:incoming>f02</bpmn:incoming>
      <bpmn:outgoing>f03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Eligible" name="Proveedor elegible">
      <bpmn:incoming>f03</bpmn:incoming>
      <bpmn:outgoing>f04</bpmn:outgoing>
      <bpmn:outgoing>f05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Verify" name="Verificar por canal historico">
      <bpmn:incoming>f04</bpmn:incoming>
      <bpmn:outgoing>f06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Verified" name="Identidad confirmada">
      <bpmn:incoming>f06</bpmn:incoming>
      <bpmn:outgoing>f07</bpmn:outgoing>
      <bpmn:outgoing>f08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Approve" name="Revisar aprobacion independiente">
      <bpmn:incoming>f07</bpmn:incoming>
      <bpmn:outgoing>f09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Accepted" name="Autorizado sin conflicto">
      <bpmn:incoming>f09</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activate" name="Activar version en transaccion">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Notify" name="Notificar cuenta aprobada">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndOK" name="Cambio activo">
      <bpmn:incoming>f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Reject" name="Rechazar y auditar causa">
      <bpmn:incoming>f05</bpmn:incoming>
      <bpmn:incoming>f08</bpmn:incoming>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndNo" name="Solicitud rechazada">
      <bpmn:incoming>f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f01" sourceRef="Start" targetRef="Register" />
    <bpmn:sequenceFlow id="f02" sourceRef="Register" targetRef="Validate" />
    <bpmn:sequenceFlow id="f03" sourceRef="Validate" targetRef="Eligible" />
    <bpmn:sequenceFlow id="f04" sourceRef="Eligible" targetRef="Verify" name="Si" />
    <bpmn:sequenceFlow id="f05" sourceRef="Eligible" targetRef="Reject" name="No" />
    <bpmn:sequenceFlow id="f06" sourceRef="Verify" targetRef="Verified" />
    <bpmn:sequenceFlow id="f07" sourceRef="Verified" targetRef="Approve" name="Si" />
    <bpmn:sequenceFlow id="f08" sourceRef="Verified" targetRef="Reject" name="No" />
    <bpmn:sequenceFlow id="f09" sourceRef="Approve" targetRef="Accepted" />
    <bpmn:sequenceFlow id="f10" sourceRef="Accepted" targetRef="Activate" name="Si" />
    <bpmn:sequenceFlow id="f11" sourceRef="Accepted" targetRef="Reject" name="No" />
    <bpmn:sequenceFlow id="f12" sourceRef="Activate" targetRef="Notify" />
    <bpmn:sequenceFlow id="f13" sourceRef="Notify" targetRef="EndOK" />
    <bpmn:sequenceFlow id="f14" sourceRef="Reject" targetRef="EndNo" />
  </bpmn:process>
